# Copy to .env and fill in as needed. Loaded by scripts/local.sh.
BUILD_ENV=local

# Local stack (defaults live in build.env; override here if ports collide).
APP_DOMAIN=biz.loc
API_DOMAIN=api.biz.loc
HTTP_PORT=9080
HTTPS_PORT=9443

# Cloud/production values consumed by docker-compose.cloud.yml. DATABASE_URL must be mysql://.
DATABASE_URL=
PUBLIC_APP_URL=https://biz.seferdesign.com
PUBLIC_API_URL=https://api.biz.seferdesign.com
CORS_ALLOWED_ORIGINS=https://biz.seferdesign.com
API_INTERNAL_URL=

AWS_PROFILE=
AWS_REGION=us-east-1
